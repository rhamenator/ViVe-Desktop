<Window x:Class="ViVe.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ViVe Desktop" Icon="Assets/App.ico" Width="1180" Height="900" MinWidth="960" MinHeight="800">
<Grid Margin="26">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,16">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="UpdateDictionaryButton" Content="Update Dictionary" Click="UpdateDictionary" ToolTip="Download the latest feature names from GitHub. No Windows features are changed."/><Button Content="Run as administrator" Click="Elevate"/></StackPanel>
<StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/App.png" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="ViVe Desktop" FontSize="30" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Windows feature configurations" Opacity=".65" Margin="0,5,0,0"/></StackPanel>
</DockPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,16"><TextBlock Text="Experimental features can affect Windows stability. Changes require administrator access; a restart may be needed." TextWrapping="Wrap"/><TextBlock x:Name="DictionaryStatus" Text="Dictionary: bundled names. Updates connect to GitHub only when requested." TextWrapping="Wrap" Opacity=".7" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Row="2" Margin="0,0,0,12">
<TextBlock Text="Filter the list" FontWeight="SemiBold" Margin="0,0,0,5"/>
<TextBlock Text="Search any part of a name or ID, then narrow the results. Filters combine and never change features." Opacity=".7" Margin="0,0,0,8"/>
<DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Refresh features" Click="Refresh"/><ComboBox x:Name="Store" DockPanel.Dock="Right" Width="155" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="StoreChanged" AutomationProperties.Name="Configuration store"><ComboBoxItem Content="Runtime store"/><ComboBoxItem Content="Boot store"/></ComboBox><TextBox x:Name="Search" TextChanged="Filter" ToolTip="Name or ID contains..." AutomationProperties.Name="Filter by name or ID" KeyDown="SearchKeyDown"/></DockPanel>
<WrapPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="State" Margin="0,0,0,4"/><ComboBox x:Name="StateFilter" Width="145" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="State filter"><ComboBoxItem Content="All states"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Default"/></ComboBox></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="Priority" Margin="0,0,0,4"/><ComboBox x:Name="PriorityFilter" Width="200" SelectionChanged="FilterChanged" AutomationProperties.Name="Priority filter"/></StackPanel>
<StackPanel Margin="0,0,12,0"><TextBlock Text="Variant (exact number)" Margin="0,0,0,4"/><TextBox x:Name="VariantFilter" Width="160" TextChanged="Filter" ToolTip="Leave empty for all variants; otherwise enter 0–63." AutomationProperties.Name="Variant filter"/></StackPanel>
<Button Content="Clear filters" Click="ClearFilters" VerticalAlignment="Bottom"/>
</WrapPanel><TextBlock x:Name="FilterHint" Opacity=".7" Margin="0,6,0,0" TextWrapping="Wrap"/>
</StackPanel>
<DataGrid Grid.Row="3" x:Name="Features" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Selected" EnableRowVirtualization="True" CanUserAddRows="False" CanUserSortColumns="True">
<DataGrid.Columns><DataGridTextColumn Header="Feature ID" Binding="{Binding Id}" Width="110"/><DataGridTextColumn Header="Feature name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="115"/><DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="70"/><DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="80"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="4" Margin="0,14,0,12">
<TextBlock x:Name="Summary" Margin="0,0,0,8"/>
<TextBlock Text="Go to ID / change feature" FontWeight="SemiBold" Margin="0,0,0,5"/>
<TextBlock Text="Select a row or enter an ID. Go to ID finds an exact match, then a prefix or nearest ID; it clears list filters." TextWrapping="Wrap" Opacity=".7" Margin="0,0,0,8"/>
<WrapPanel><TextBox x:Name="FeatureId" Width="145" Margin="0,0,12,0" ToolTip="Positive feature ID; partial numbers are supported for navigation." AutomationProperties.Name="Feature ID" KeyDown="IdKeyDown"/><Button Content="Go to ID" Click="Query"/><Button x:Name="EnableButton" Content="Enable" Click="EnableFeature"/><Button x:Name="DisableButton" Content="Disable" Click="DisableFeature"/><Button x:Name="ResetButton" Content="Reset User override" Click="ResetFeature"/><Button Content="Export snapshot" Click="Export"/></WrapPanel>
<TextBlock Text="Priority is an override layer; a higher priority can mask lower ones. Variant is an experiment value, not an enabled/disabled state." TextWrapping="Wrap" Opacity=".7" Margin="0,8,0,0"/>
</StackPanel>
<TextBox Grid.Row="5" x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
</Grid></Window>
