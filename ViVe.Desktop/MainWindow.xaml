<Window x:Class="ViVe.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ViVe.Desktop" Title="ViVe Desktop" Icon="Assets/App.ico" Width="1300" Height="800" MinWidth="980" MinHeight="720">
<Window.Resources>
<Style x:Key="FilterLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Opacity" Value=".8"/></Style>
<Style x:Key="FilterCombo" TargetType="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/></Style>
</Window.Resources>
<Grid Margin="22">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="TableRegion" Height="3*" MinHeight="245"/><RowDefinition Height="6"/><RowDefinition x:Name="LogRegion" Height="*" MinHeight="100"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,12">
<WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Content="Refresh features" Click="Refresh"/><Button x:Name="UpdateDictionaryButton" Content="Update Dictionary" Click="UpdateDictionary" ToolTip="Download the latest feature names from GitHub. No Windows features are changed."/><TextBlock Text="Administrator" VerticalAlignment="Center" Margin="8,0,0,0" Opacity=".7"/></WrapPanel>
<StackPanel Orientation="Horizontal"><Image Source="Assets/App.png" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock Text="ViVe Desktop" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
</DockPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Changes save to Runtime and Boot. Reboot Windows after changing features." TextWrapping="Wrap"/><TextBlock x:Name="DictionaryStatus" Text="Dictionary: bundled names. Update Dictionary connects to GitHub on request." TextWrapping="Wrap" Opacity=".65" Margin="0,3,0,0"/></StackPanel>
<StackPanel Grid.Row="2" Margin="0,0,0,10">
<local:AdaptiveFilterPanel>
<StackPanel MinWidth="220" MaxWidth="560" local:AdaptiveFilterPanel.Weight="2"><TextBlock Style="{StaticResource FilterLabel}" Text="Search name or ID"/><TextBox x:Name="Search" MinHeight="36" TextChanged="Filter" ToolTip="Filter the table by any part of a name or ID. Combines with the dropdowns and variant filter." AutomationProperties.Name="Filter by name or ID" KeyDown="SearchKeyDown"/></StackPanel>
<StackPanel MinWidth="140" MaxWidth="260"><TextBlock Style="{StaticResource FilterLabel}" Text="Browse store"/><ComboBox Style="{StaticResource FilterCombo}" ToolTip="Choose the store to inspect. Changes always save to both stores." x:Name="Store" SelectedIndex="0" SelectionChanged="StoreChanged" AutomationProperties.Name="Configuration store"><ComboBoxItem Content="Runtime store"/><ComboBoxItem Content="Boot store"/></ComboBox></StackPanel>
<StackPanel MinWidth="140" MaxWidth="260"><TextBlock Style="{StaticResource FilterLabel}" Text="State applies to"/><ComboBox Style="{StaticResource FilterCombo}" x:Name="StateScope" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="State scope"><ComboBoxItem Content="Effective state"/><ComboBoxItem Content="Individual row"/></ComboBox></StackPanel>
<StackPanel MinWidth="110" MaxWidth="220"><TextBlock Style="{StaticResource FilterLabel}" Text="State"/><ComboBox Style="{StaticResource FilterCombo}" x:Name="StateFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="State filter"><ComboBoxItem Content="All states"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Default"/><ComboBoxItem Content="Unknown"/></ComboBox></StackPanel>
<StackPanel MinWidth="160" MaxWidth="300"><TextBlock Style="{StaticResource FilterLabel}" Text="Row priority"/><ComboBox Style="{StaticResource FilterCombo}" x:Name="PriorityFilter" SelectionChanged="FilterChanged" AutomationProperties.Name="Priority filter"/></StackPanel>
<StackPanel MinWidth="90" MaxWidth="180"><TextBlock Style="{StaticResource FilterLabel}" Text="Row variant"/><TextBox x:Name="VariantFilter" MinHeight="36" TextChanged="Filter" ToolTip="Exact variant number, 0–63. Leave empty for all variants." AutomationProperties.Name="Variant filter"/></StackPanel>
<Button MinWidth="100" local:AdaptiveFilterPanel.Weight="0" Content="Clear filters" Click="ClearFilters" VerticalAlignment="Bottom" Margin="0"/>
</local:AdaptiveFilterPanel>
<WrapPanel Margin="0,8,0,0"><CheckBox x:Name="ShowPriorityDetails" Content="Show individual priority rows (advanced)" Checked="DetailsChanged" Unchecked="DetailsChanged" Margin="0,0,16,0" VerticalAlignment="Center"/><TextBlock x:Name="FilterHint" Opacity=".65" MaxWidth="700" TextWrapping="Wrap" VerticalAlignment="Center"/></WrapPanel>
</StackPanel>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid Grid.Row="0" x:Name="Features" MinHeight="160" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Selected" EnableRowVirtualization="True" CanUserAddRows="False" CanUserSortColumns="True">
<DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding EffectiveDetail}"/></Style></DataGrid.RowStyle>
<DataGrid.Columns><DataGridTextColumn Header="Feature ID" Binding="{Binding Id}" Width="110"/><DataGridTextColumn Header="Feature name" Binding="{Binding Name}" Width="*" MinWidth="200"/><DataGridTextColumn Header="Effective state" Binding="{Binding EffectiveState}" Width="110"/><DataGridTextColumn Header="Resolved priority" Binding="{Binding EffectivePriority}" Width="140"/><DataGridTextColumn x:Name="RowStateColumn" Header="Row state" Binding="{Binding State}" Width="90"/><DataGridTextColumn x:Name="RowPriorityColumn" Header="Row priority" Binding="{Binding Priority}" Width="115"/><DataGridTextColumn x:Name="RowVariantColumn" Header="Row variant" Binding="{Binding Variant}" Width="90"/><DataGridTextColumn x:Name="PayloadColumn" Header="Payload" Binding="{Binding Payload}" Width="80"/></DataGrid.Columns>
</DataGrid>
<StackPanel Grid.Row="1" Margin="0,10,0,8">
<TextBlock x:Name="RestartNotice" TextWrapping="Wrap" FontWeight="SemiBold"/>
<TextBlock x:Name="Summary" Opacity=".75" Margin="0,0,0,8"/>
<WrapPanel ToolTip="Go to ID navigates to the exact, prefix or closest ID and clears filters. Change actions save to both stores.">
<TextBox x:Name="FeatureId" Width="140" Margin="0,0,10,0" ToolTip="Feature ID to navigate to or change. Partial numbers are supported for navigation. Press Enter to go." AutomationProperties.Name="Feature ID" KeyDown="IdKeyDown"/>
<Button Content="Go to ID" Click="Query"/><Button x:Name="EnableButton" Content="Enable" Click="EnableFeature"/><Button x:Name="DisableButton" Content="Disable" Click="DisableFeature"/><Button x:Name="ResetButton" Content="Reset User override" Click="ResetFeature"/><Button Content="Export snapshot" Click="Export"/>
</WrapPanel>
</StackPanel>
</Grid><GridSplitter Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the table and activity log." AutomationProperties.Name="Resize table and activity log"/><GroupBox Grid.Row="5" Header="Activity log" Padding="0,4,0,0" ToolTip="Expand to see query, dictionary update and feature-change details.">
<TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
</GroupBox>
</Grid></Window>
