<Window x:Class="ViVe.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ViVe Desktop" Width="1120" Height="780" MinWidth="900" MinHeight="650">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="Run as administrator" Click="Elevate"/><StackPanel><TextBlock Text="ViVe Desktop" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Windows feature configurations · English · Offline" Opacity=".65" Margin="0,4,0,0"/></StackPanel></DockPanel>
<TextBlock Grid.Row="1" Text="Experimental features can affect Windows stability. Changes require administrator access; a restart may be needed." TextWrapping="Wrap" Margin="0,0,0,18"/>
<DockPanel Grid.Row="2" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh"/><ComboBox x:Name="Store" DockPanel.Dock="Right" Width="150" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="StoreChanged"><ComboBoxItem Content="Runtime store"/><ComboBoxItem Content="Boot store"/></ComboBox><TextBox x:Name="Search" TextChanged="Filter" ToolTip="Search by ID or feature name" AutomationProperties.Name="Search features"/></DockPanel>
<DataGrid Grid.Row="3" x:Name="Features" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Selected" EnableRowVirtualization="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Feature ID" Binding="{Binding Id}" Width="120"/><DataGridTextColumn Header="Feature name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="105"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="110"/><DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="80"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="4" Margin="0,18,0,14"><TextBlock x:Name="Summary" Margin="0,0,0,10"/><WrapPanel><TextBox x:Name="FeatureId" Width="150" Margin="0,0,12,0" ToolTip="Feature ID (positive integer)" AutomationProperties.Name="Feature ID"/><Button Content="Query ID" Click="Query"/><Button x:Name="EnableButton" Content="Enable" Click="EnableFeature"/><Button x:Name="DisableButton" Content="Disable" Click="DisableFeature"/><Button x:Name="ResetButton" Content="Reset override" Click="ResetFeature"/><Button Content="Export snapshot" Click="Export"/></WrapPanel></StackPanel>
<TextBox Grid.Row="5" x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
</Grid></Window>
