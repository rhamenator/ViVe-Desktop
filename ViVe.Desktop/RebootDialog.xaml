<Window x:Class="ViVe.Desktop.RebootDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Restart Windows?" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
<StackPanel Margin="24" Width="440">
<TextBlock Text="Restart to apply your feature changes" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock Text="You changed Windows feature settings in this session. Save your work before restarting." TextWrapping="Wrap" Margin="0,12,0,20"/>
<WrapPanel HorizontalAlignment="Right"><Button Content="Restart now" Click="RestartNow"/><Button Content="Later" Click="Later" IsDefault="True"/><Button Content="Keep app open" Click="KeepOpen" IsCancel="True" Margin="0"/></WrapPanel>
</StackPanel></Window>
